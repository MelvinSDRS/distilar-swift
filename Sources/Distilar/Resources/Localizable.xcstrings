          }
        }
      }
    },
    "This feedback could not be saved on the device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message n'a pas pu être enregistré sur l'appareil."
          }
        }
      }
    },
    "This feedback could not be sent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message n'a pas pu être envoyé."
          }
        }
      }
    },
    "This image cannot be used. Try another one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'utiliser cette image, il faut en choisir une autre."
          }
        }
      }
    },
    "Too much feedback is waiting for a connection. Try again once you are online." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de messages attendent déjà une connexion. Il faudra réessayer une fois en ligne."
          }
        }
      }
    },
